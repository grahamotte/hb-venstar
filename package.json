{
  "name": "homebridge-go-venstar",
  "displayName": "GoVenstar",
  "type": "module",
  "version": "1.2.2",
  "description": "A Homebridge plugin for Venstar thermostats",
  "author": "Graham Otte",
  "license": "Apache-2.0",
  "homepage": "https://codeberg.org/grahamotte/homebridge-go-venstar",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@codeberg.org/grahamotte/homebridge-go-venstar.git"
  },
  "bugs": {
    "url": "https://codeberg.org/grahamotte/homebridge-go-venstar/issues"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc",
    "lint": "eslint .",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "validate": "npm run lint && npm test && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
